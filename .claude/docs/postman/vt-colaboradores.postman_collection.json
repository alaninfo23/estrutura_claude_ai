            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beneficiaryDocumentNumber\": \"{{beneficiaryDocumentNumber_new}}\",\n  \"registrationNumber\": \"{{registrationNumber_new}}\",\n  \"fullName\": \"{{fullName_new}}\",\n  \"idNumber\": \"{{idNumber_new}}\",\n  \"idNumberState\": \"{{idNumberState_new}}\",\n  \"birthDate\": \"{{birthDate_new}}\",\n  \"workingDaysPerMonth\": {{workingDaysPerMonth_new}},\n  \"workAddressId\": {{workAddressId}},\n  \"benefits\": [\n    {\n      \"saleCode\": \"{{saleCode_new}}\",\n      \"unitPrice\": {{unitPrice_new}},\n      \"usagePerDay\": {{usagePerDay_new}}\n    }\n  ]\n}"
