        {
          "name": "9 - Criar novo colaborador com sucesso (201)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{vt-colaboradores}}/companies/{{companyId}}/beneficiaries?action=INSERT",
              "host": ["{{vt-colaboradores}}"],
              "path": ["companies", "{{companyId}}", "beneficiaries"],
              "query": [{ "key": "action", "value": "INSERT" }]
