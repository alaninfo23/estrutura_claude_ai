  "item": [
        {
          "name": "1 - Listar colaboradores com paginação e ordenação",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{vt-colaboradores}}/companies/{{companyId}}/beneficiaries?page=0&size=10&sort=fullName,asc",
              "host": ["{{vt-colaboradores}}"],
              "path": ["companies", "{{companyId}}", "beneficiaries"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "fullName,asc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Campos de paginação presentes', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('content');",
                  "  pm.expect(json).to.have.property('page');",
                  "  pm.expect(json).to.have.property('size');",
                  "  pm.expect(json).to.have.property('totalElements');",
                  "  pm.expect(json).to.have.property('totalPages');",
                  "  pm.expect(json.content.length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
          ]
        },
