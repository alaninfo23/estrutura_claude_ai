# Ignorar Documentacao inteira
/.claude/Documentacao/*

# Manter a pasta principal
!/.claude/Documentacao/.gitkeep

# Manter estas duas pastas e todo o conteúdo
!/.claude/Documentacao/postman/
!/.claude/Documentacao/postman/**

!/.claude/Documentacao/test_cases/
!/.claude/Documentacao/test_cases/**

# Ignorar conteúdo das pastas, mas manter os diretórios
/.claude/docs/test_cases/*
!/.claude/docs/test_cases/.gitkeep

/.claude/docs/postman/*
!/.claude/docs/postman/.gitkeep